<!DOCTYPE html>
<!-- Generated by build.py. Edit content.yaml or templates/index.html.jinja instead. -->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ name }}</title>
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <div class="left-column">
            <div class="left-content-top">
                <h1>{{ name }}</h1>
                <p><i>{{ tagline }}</i></p>
                <hr>
                {{ bio | markdown }}
            </div>
            <div class="left-content-bottom">
                <nav>
{% for link in social_links %}
                    <a href="{{ link.url }}">{{ link.label }}</a>
{% endfor %}
                </nav>
            </div>
        </div>
        <div class="right-column">
            <p class="intro-text">{{ intro }}</p>
{% for project in projects %}
            <div class="project">
                <div class="project-header">
                    <div class="project-info-left">
                        <span class="project-year">{{ project.years }}</span>
                        <span class="project-role">{{ project.role }}</span>
                    </div>
                    <a href="{{ project.url }}" class="project-link">{{ project.name }} &rarr;</a>
                </div>
                {{ project.description | markdown }}
{% if project.responsibilities | default([]) %}
                <p>{{ project.responsibilities_label | default('Responsible for:') }}</p>
                <ul>
{% for responsibility in project.responsibilities %}
                    <li>{{ responsibility | markdown }}</li>
{% endfor %}
                </ul>
{% endif %}
{% if project.tech | default([]) %}
                <p class="tech-stack"><strong>Tech:</strong> {{ project.tech | join(' · ') }}</p>
{% endif %}
            </div>
{% endfor %}
            <div class="project">
                <span class="project-year">{{ other_work.heading }}</span>
                {{ other_work.description | markdown }}
            </div>
        </div>
    </div>
</body>
</html>
